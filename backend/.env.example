# Copy to .env (git-ignored). Never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Database (Tiger Data): one connection string...
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require
# ...or separate values (used only when DATABASE_URL is empty)
# DB_HOST=
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# DB_SSLMODE=require
# Set to 1 to force the template explainer / slider fallback
GEMINI_DISABLED=0
GEMINI_TIMEOUT_S=20
