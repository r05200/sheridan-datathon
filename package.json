{
  "name": "cushion",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/run-api.mjs --reload",
    "dev:web": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "serve": "npm run build && node scripts/run-api.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
